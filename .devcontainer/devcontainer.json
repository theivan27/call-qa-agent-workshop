{
  "name": "Call QA Agent Workshop",

  // Python 3.10 on purpose: the Static Web Apps built-in API runs 3.10, so the
  // local environment matches what gets deployed.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bookworm",

  "features": {
    // Node is needed for the Static Web Apps CLI and Azure Functions Core Tools.
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "forwardPorts": [4280, 7071],
  "portsAttributes": {
    "4280": {
      "label": "Call QA Reviewer web app",
      "onAutoForward": "notify"
    },
    "7071": {
      "label": "Functions API (used via 4280)",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-azurefunctions",
        "ms-azuretools.vscode-azurestaticwebapps",
        "ms-azuretools.vscode-azureresourcegroups"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": false,
        "files.exclude": {
          "**/__pycache__": true
        }
      }
    }
  },

  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  },

  "hostRequirements": {
    "cpus": 2
  }
}
