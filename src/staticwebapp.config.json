{
  "platform": {
    "apiRuntime": "python:3.10"
  },
  "routes": [
    { "route": "/guide", "rewrite": "/guide/index.html" },
    { "route": "/guide/", "rewrite": "/guide/index.html" }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/guide/*",
      "*.{css,js,svg,png,ico,mp3}"
    ]
  }
}
