# Copy this file to .env and fill in your values.
# Project endpoint from the Foundry portal welcome screen:
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
# The name of the model deployment in your Foundry project:
MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
# The agent name (any lowercase name with dashes):
FOUNDRY_AGENT_NAME=call-qa-reviewer
# Optional, for scripts/generate_audio.py (Keys and Endpoint page of your Foundry or Speech resource):
SPEECH_KEY=
SPEECH_REGION=southeastasia
