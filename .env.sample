# Copy this file to .env and fill in your values.
# Project endpoint from the Foundry portal welcome screen:
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
# The name of the model deployment in your Foundry project:
MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
# The agent name (any lowercase name with dashes):
FOUNDRY_AGENT_NAME=call-qa-reviewer
# Speech is used to transcribe the call recordings, and by the optional audio lab.
# Both normally work from your `az login` session, so you can leave these blank.
# Set SPEECH_ENDPOINT only if you use a standalone Speech resource rather than your
# Foundry resource; set SPEECH_KEY only if you cannot use Entra ID sign-in.
SPEECH_ENDPOINT=
SPEECH_KEY=
SPEECH_REGION=southeastasia
